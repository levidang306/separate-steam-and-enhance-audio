# Restoration settings.
#
# Every value below is already the default. The file exists to document what is
# tunable and why each default is the cautious choice -- copy it to `.env` and
# change only what you have measured a reason to change.
#
# The governing rule: if a step cannot prove it should run, it must not run.
# A restoration chain that runs unconditionally will make good audio worse, and
# it will do so silently.

# --- Signal integrity --------------------------------------------------------

# 0 = follow the source sample rate. Pinning a rate resamples material that
# never needed it, and a resampler is a filter.
RESTORE_OUTPUT_SAMPLE_RATE=0

# auto | joint | mid_side
# How to keep a stereo image through a model that may only emit mono.
#   auto     - run normally, and only pay for a mid/side pass if the model is
#              seen to drop channels. Correct either way, free when it behaves.
#   joint    - trust the model.
#   mid_side - always split, two passes, for a known mono-only model.
RESTORE_STEREO_MODE=auto

# Refuse to write a stem whose channel count does not match its input. A
# collapse is unrecoverable and invisible in every other metric.
RESTORE_ENFORCE_CHANNEL_COUNT=true

# --- Tempo gate --------------------------------------------------------------

# Off. On the reference material this was the most destructive stage: it warped
# a solo guitar by 375ms from a beat grid covering 41% of the track. It only
# helps material with a real, steady, percussive pulse, which must be shown.
RESTORE_TEMPO_ENABLED=false

# A grid covering less than this cannot describe the track's timing; uncovered
# regions get copied and inherit whatever drift the covered ones accumulated.
RESTORE_TEMPO_MIN_GRID_COVERAGE=0.80

# Beat-to-beat tempo has to be steady before a "correct" tempo exists to warp
# toward. Percentage of the median BPM.
RESTORE_TEMPO_MAX_BPM_STD_PCT=2.0

# Onset strength expected from percussion. Melodic material scores far below
# this, which is the point: a guitar is not a click track.
RESTORE_TEMPO_MIN_PERCUSSIVE_SCORE=0.30
RESTORE_TEMPO_MIN_CONFIDENCE=0.60

# Below this deviation, stretching costs more smearing than the drift is worth.
# Was 0.005, which spent phase-vocoder damage on rounding error.
RESTORE_TEMPO_MIN_CORRECTION=0.02

# Outside this range it is a beat-tracking failure, not drift. The old
# (0.80, 1.25) let one mis-detected beat stretch a segment by a quarter.
RESTORE_TEMPO_MAX_RATE_LOW=0.98
RESTORE_TEMPO_MAX_RATE_HIGH=1.02

# Total timing movement the step may introduce, end to end.
RESTORE_TEMPO_MAX_CUMULATIVE_DRIFT_MS=50

# Separated stems have had their transients reshaped by the separator, so beat
# tracking on them is less trustworthy than on a full mix.
RESTORE_TEMPO_ALLOW_ON_SEPARATED=false

# --- Denoise -----------------------------------------------------------------

RESTORE_DENOISE_ENABLED=true

# Partial. At 1.0 the model's output replaces the signal outright, and whatever
# it removed -- room tone, reverb tails, finger noise -- is gone for good.
RESTORE_DENOISE_WET=0.5

# Denoise acts freely where hiss lives and barely at all where music does.
#
# 5-10kHz is 0.15, not the 0.40 the plan starts from. Swept from 0.0 to 0.40
# (scripts/sweep.py), noise removal is flat at 1.30-1.32dB while presence loss
# grows from -0.71dB to -1.40dB in 8-10kHz: the weight buys 0.02dB of hiss for
# 0.69dB of the band carrying pick attack and string articulation. 0.15 is the
# highest value keeping the reference guitar inside +/-1dB with the worst model.
RESTORE_DENOISE_WEIGHT_BELOW_2K=0.0
RESTORE_DENOISE_WEIGHT_2K_5K=0.15
RESTORE_DENOISE_WEIGHT_5K_10K=0.15
RESTORE_DENOISE_WEIGHT_ABOVE_10K=1.00

# Hard per-frame floor on how far any stage may pull the source down. This is
# what stops the downward-expander behaviour measured on the reference file
# (-15.75dB on the quietest frames) from eating note decay.
RESTORE_MAX_ATTENUATION_DB=6.0

# Only denoise when there is measurable noise to remove.
RESTORE_DENOISE_MIN_NOISE_FLOOR_DB=-75

# --- Bandwidth ---------------------------------------------------------------

RESTORE_BANDWIDTH_ENABLED=true
RESTORE_BANDWIDTH_WET=0.7

# A cliff outside this range is not a codec cutoff worth restoring. Below the
# low bound it is tonal balance; above the high bound there is nothing left to
# add. The reference guitar rolled off at 2.8kHz with no cliff at all, and
# synthesising a high band for it produced content with 0.012 coherence.
RESTORE_BANDWIDTH_MIN_CLIFF_HZ=8000
RESTORE_BANDWIDTH_MAX_CLIFF_HZ=20000
RESTORE_BANDWIDTH_MIN_ENERGY_BELOW_CLIFF_PCT=1.0

# Apollo chunking. 2s of overlap replaces 0.5s: the short fade left a level
# swing tracking the chunk stride. See suno_restore/bandwidth.py:chunk_window
# for the measured caveat on when a longer fade helps.
RESTORE_BANDWIDTH_CHUNK_S=10
RESTORE_BANDWIDTH_OVERLAP_S=2.0

# --- Damage mask -------------------------------------------------------------

RESTORE_DAMAGE_FRAME_MS=20
RESTORE_DAMAGE_FEATHER_MS=100

# --- Verification / rollback -------------------------------------------------

# On. This is the backstop that makes every other stage reversible: a stem that
# fails these gates is replaced by its dry input and reported as not enhanced.
RESTORE_VERIFY_ENABLED=true
RESTORE_VERIFY_MAX_DURATION_DELTA_MS=5
RESTORE_VERIFY_MAX_OFFSET_DRIFT_MS=5
RESTORE_VERIFY_MIN_CORRELATION=0.90
RESTORE_VERIFY_MAX_BAND_DELTA_DB=1.5
RESTORE_VERIFY_BAND_LOW_HZ=100
RESTORE_VERIFY_BAND_HIGH_HZ=10000
RESTORE_VERIFY_MAX_ATTACK_SLOPE_LOSS_DB=0.5
RESTORE_VERIFY_MAX_EXPANSION_SPREAD_DB=6.0

# Added during Phase 2: the hiss figure is the measurement that actually
# discriminates. A broadband floor number is dominated by ringing low-frequency
# tails, which are music, not noise.
RESTORE_DENOISE_MIN_HISS_DB=-70
RESTORE_DENOISE_MIN_CONFIDENCE=0.05

# Added during Phase 6. Some regressions add rather than remove: a synthesised
# high band unrelated to the source damages nothing measurable, so it clears
# every preservation gate while making the result worse. Roll back when the
# score is this far negative even though no individual gate broke.
RESTORE_VERIFY_MIN_QUALITY_GAIN=0.02
RESTORE_VERIFY_MIN_QUALITY_SCORE=-0.25

# Checked on the model's raw output, before blending. The damage mask follows
# the music, so blending imposes a music-shaped envelope on whatever came back
# and an invented high band ends up looking derived. Measured on the model's own
# output the two separate cleanly: ~0.9 derived against ~0.0 invented.
RESTORE_BANDWIDTH_MIN_RELATEDNESS=0.30
