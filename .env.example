# Restoration settings.
#
# Nothing loads this file. Values are read straight from the process
# environment, so a `.env` sitting here has no effect unless something exports
# it first -- set the variables in the shell that launches the app:
#
#   RESTORE_OUTPUT_SAMPLE_RATE=44100 .venv/Scripts/streamlit run streamlit_app.py
#
# Every enabled step runs unconditionally and at full strength. What remains
# configurable describes the signal itself, not whether to process it.

# --- Signal integrity --------------------------------------------------------

# 0 = follow the source sample rate. Pinning a rate resamples material that
# never needed it, and a resampler is a filter.
RESTORE_OUTPUT_SAMPLE_RATE=0

# auto | joint | mid_side
# How to keep a stereo image through a model that may only emit mono.
#   auto     - run normally, and only pay for a mid/side pass if the model is
#              seen to drop channels. Correct either way, free when it behaves.
#   joint    - trust the model.
#   mid_side - always split, two passes, for a known mono-only model.
RESTORE_STEREO_MODE=auto

# Refuse to write a stem whose channel count does not match its input. This is
# an assertion against a specific bug rather than a policy: the denoise model
# can write a mono file, and adopting its channel count turned every stereo
# stem into a mono one while still reporting success.
RESTORE_ENFORCE_CHANNEL_COUNT=true

# --- Bandwidth chunking ------------------------------------------------------

# Apollo cannot take a whole stem at once, so it runs in overlapping chunks that
# are crossfaded together. 2s of overlap rather than 0.5s: the short fade left a
# level swing in the synthesised high band tracking the chunk stride exactly.
RESTORE_BANDWIDTH_CHUNK_S=10
RESTORE_BANDWIDTH_OVERLAP_S=2.0
